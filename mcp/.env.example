# ==========================================
# cPanel & Let's Encrypt SSL Configuration
# ==========================================

# 1. cPanel Server Connection
# Host URL of your cPanel server (usually port 2083)
CPANEL_HOST=https://cpanel.yourdomain.com:2083

# cPanel account username
CPANEL_USERNAME=your_username

# cPanel API Token:
# Generate this in cPanel:
# Go to cPanel -> Security -> Manage API Tokens -> Create API Token
# Ensure the token has permissions for: SSL, Fileman (for HTTP challenge), ZoneEdit (for DNS challenge)
CPANEL_API_TOKEN=your_cpanel_api_token_here

# SSL verification for the cPanel API endpoint:
# Set to 'false' if your cPanel server uses a self-signed hostname certificate
CPANEL_VERIFY_SSL=false

# 2. ACME / Let's Encrypt Settings
# Notification email for Let's Encrypt account registration & expiry alerts
ACME_EMAIL=admin@yourdomain.com

# Set to 'true' while testing to use Let's Encrypt Staging environment (prevents rate limits)
# Set to 'false' for live, trusted production certificates
ACME_STAGING=false

# Default webroot for HTTP-01 challenge upload (relative to cPanel user root)
CPANEL_WEBROOT=public_html

# 3. Domain Configuration
# Comma-separated list of domains to issue/renew certificates for.
# Optional: if left blank, automated renewal will attempt to auto-detect installed domains from your cPanel account.
DOMAINS=example.com,www.example.com

